{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start All Services",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in \\d+ms|Server listening at|Local:.*"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "🌐 Start Web Only",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "dev:web"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "source": "vite",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": "ready in \\d+ms"
        }
      }
    },
    {
      "label": "⚡ Start API Only",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "dev:api"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "fastify",
        "source": "api",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Server listening at.*"
        }
      }
    },
    {
      "label": "📱 Start Mobile Only",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "dev:mobile"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true,
        "clear": false
      },
      "isBackground": true
    },
    {
      "label": "🛑 Stop All Services",
      "type": "shell",
      "command": ".\\manage.ps1",
      "args": [
        "stop"
      ],
      "group": "build",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "🔄 Restart All Services",
      "type": "shell",
      "command": ".\\manage.ps1",
      "args": [
        "restart"
      ],
      "group": "build",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "clear": true
      }
    },
    {
      "label": "📊 Service Status",
      "type": "shell",
      "command": ".\\manage.ps1",
      "args": [
        "status"
      ],
      "group": "test",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "🧪 Run All Tests",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "test"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true
      }
    },
    {
      "label": "🎭 Run Playwright Tests",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "test:e2e"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": true
      },
      "dependsOn": "📊 Service Status"
    },
    {
      "label": "🗄️ Database: Generate Prisma Client",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "db:generate"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "📤 Database: Push Schema",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "db:push"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "🎨 Database: Open Studio",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "db:studio"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "isBackground": true
    },
    {
      "label": "🏗️ Build All",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "build"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "🧹 Clean & Install",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "pnpm clean; pnpm install"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "🔍 Lint All",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "lint"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": [
        "$eslint-stylish"
      ]
    },
    {
      "label": "🔧 Fix Lint Issues",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "lint:fix"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}