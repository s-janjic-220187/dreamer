{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "../../",
    "paths": {
      "@dreamer/shared": ["./libs/shared/src/index.ts"],
      "@dreamer/shared/*": ["./libs/shared/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../libs/shared/src/**/*",
    "prisma/schema.prisma"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}